/-- **Regime 2 of (iii)'s core**: `F > 0` on `[0.45, 3]`. -/
theorem core_pos_regime2 :
    ∀ θ : ℝ, ((45/100 : ℚ) : ℝ) ≤ θ → θ ≤ ((3 : ℚ) : ℝ) → 0 < F θ := by
  refine sweepC_sound (k := 4) (n := 10) (m := 10 ^ 9) (by norm_num) (by norm_num)
    sweepCells (45/100) ?_ ?_
  · decide +kernel
  · rw [← List.all_eq_true]
    exact cells_ok

